# Copy to .env and fill in. .env is git-ignored — never commit real secrets.

# Claude API key (or run `ant auth login` and leave this unset).
ANTHROPIC_API_KEY=

# Notion internal-integration token. Create at https://www.notion.so/my-integrations,
# then share the Dashboard page with the integration (Share -> Connections).
NOTION_TOKEN=

